# Private VPS file: /opt/bemol-infra/.env.staging, mode 600.
# New installation: set secrets once, then run make init; see docs/STAGING.md.
# Existing installation: preserve live secrets and use make deploy.
# Use published sha-<commit> tags or staging@sha256:<digest> values.
# Use staging only when deliberately enabling subsequent rolling image updates.
UI_IMAGE=ghcr.io/typeitorg/bemol-ui
UI_VERSION=replace-with-current-sha-tag
API_IMAGE=ghcr.io/typeitorg/bemol-api
API_VERSION=replace-with-current-sha-tag

# Host Nginx uses UI loopback; keep port 3000 aligned with its upstream.
UI_HOST_PORT=3000
API_HOST_PORT=8080
AUTH_COOKIE_SECURE=true
UI_MEMORY_LIMIT=1024m
UI_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1024m
API_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1024m
POSTGRES_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.5

# New installation: choose DB credentials; updates must preserve existing values.
DB_NAME=bemol
DB_USER=bemol
DB_PASSWORD=replace-with-secret-value

# New installation: generate auth keys; updates must preserve them.
JWT_SECRET=replace-with-secret-value
REFRESH_REPLAY_ENCRYPTION_KEY=replace-with-secret-value
REFRESH_REPLAY_TTL=5s
WEBAUTHN_RP_ID=staging.bemol.com.ar
WEBAUTHN_ALLOWED_ORIGINS=https://staging.bemol.com.ar

MAIL_HOST=replace-with-existing-value
MAIL_PORT=587
MAIL_USERNAME=replace-with-existing-value
MAIL_PASSWORD=replace-with-existing-value
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=replace-with-existing-value

FRONTEND_PUBLIC_URL=https://staging.bemol.com.ar
INSTITUTIONAL_BASE_DOMAIN=staging.bemol.com.ar
EMAIL_VERIFICATION_FRONTEND_URL=https://staging.bemol.com.ar
PASSWORD_RECOVERY_FRONTEND_URL=https://staging.bemol.com.ar
PASSWORD_RECOVERY_TOKEN_EXPIRATION=30m

# New installation: configure the initial admin if needed; do not reset an existing one.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=bemol/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Preserve the current staging-only auto-login policy and UUIDs if enabled.
AUTO_LOGIN_ENABLED=false
AUTO_LOGIN_USER_ID=
AUTO_LOGIN_INSTITUTION_ID=

# Manual or scheduled backups only; deployment does not use these settings.
BACKUP_DIR=/var/backups/bemol
BACKUP_RETENTION_DAYS=7

# Cloudflare, SSH and registry credentials do not belong in this environment.
