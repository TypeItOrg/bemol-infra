# Generate with make render-staging-config.
UI_IMAGE=ghcr.io/typeitorg/bemol-ui
UI_VERSION=staging
API_IMAGE=ghcr.io/typeitorg/bemol-api
API_VERSION=staging

# API listens on localhost.
API_HOST_PORT=8080
AUTH_COOKIE_SECURE=true
UI_MEMORY_LIMIT=1024m
UI_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1024m
API_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1024m
POSTGRES_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.5

# Reuse the existing database.
DB_NAME=bemol
DB_USER=bemol
DB_PASSWORD=replace-with-existing-value

# Keep existing signing keys.
JWT_SECRET=replace-with-existing-value
REFRESH_REPLAY_ENCRYPTION_KEY=replace-with-existing-value
REFRESH_REPLAY_TTL=5s
WEBAUTHN_RP_ID=${STAGING_DOMAIN}
WEBAUTHN_ALLOWED_ORIGINS=https://${STAGING_DOMAIN}

MAIL_HOST=replace-with-existing-value
MAIL_PORT=587
MAIL_USERNAME=replace-with-existing-value
MAIL_PASSWORD=replace-with-existing-value
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=replace-with-existing-value

FRONTEND_PUBLIC_URL=https://${STAGING_DOMAIN}
INSTITUTIONAL_BASE_DOMAIN=${STAGING_DOMAIN}
EMAIL_VERIFICATION_FRONTEND_URL=https://${STAGING_DOMAIN}
PASSWORD_RECOVERY_FRONTEND_URL=https://${STAGING_DOMAIN}
PASSWORD_RECOVERY_TOKEN_EXPIRATION=30m

# Keep the current admin settings.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=bemol/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Auto-login is optional in staging.
AUTO_LOGIN_ENABLED=false
AUTO_LOGIN_USER_ID=
AUTO_LOGIN_INSTITUTION_ID=

# Set the DNS token in Traefik.
