# Dokploy > Bemol / staging > Staging Compose > Environment. Do not overwrite live secrets.
# Review against the existing private values; never reset database or auth keys.
# Use staging for the normal Actions -> GHCR -> Dokploy flow.
# Keep both variables: compose.yaml requires them before extends is merged.
UI_IMAGE=ghcr.io/typeitorg/bemol-ui
UI_VERSION=staging
API_IMAGE=ghcr.io/typeitorg/bemol-api
API_VERSION=staging

# UI has no host port; 3000 belongs to the Dokploy panel. API stays loopback-only.
API_HOST_PORT=8080
AUTH_COOKIE_SECURE=true
UI_MEMORY_LIMIT=1024m
UI_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1024m
API_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1024m
POSTGRES_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.5

# Target names after the coordinated migration in docs/RENOMBRE-BEMOL.md.
# Do not replace private values until database/role and copied data are ready.
DB_NAME=bemol
DB_USER=bemol
DB_PASSWORD=replace-with-existing-value
# Staging Compose sets DB_REQUIRE_EXISTING=true internally; missing DB must fail.

# Preserve these keys: replacing them can invalidate sessions and passkeys.
JWT_SECRET=replace-with-existing-value
REFRESH_REPLAY_ENCRYPTION_KEY=replace-with-existing-value
REFRESH_REPLAY_TTL=5s
WEBAUTHN_RP_ID=staging.typeit.com.ar
WEBAUTHN_ALLOWED_ORIGINS=https://staging.typeit.com.ar

MAIL_HOST=replace-with-existing-value
MAIL_PORT=587
MAIL_USERNAME=replace-with-existing-value
MAIL_PASSWORD=replace-with-existing-value
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=replace-with-existing-value

FRONTEND_PUBLIC_URL=https://staging.typeit.com.ar
INSTITUTIONAL_BASE_DOMAIN=staging.typeit.com.ar
EMAIL_VERIFICATION_FRONTEND_URL=https://staging.typeit.com.ar
PASSWORD_RECOVERY_FRONTEND_URL=https://staging.typeit.com.ar
PASSWORD_RECOVERY_TOKEN_EXPIRATION=30m

# Preserve current values if configured; do not create/reset an administrator.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=bemol/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Preserve the current staging-only auto-login policy and UUIDs if enabled.
AUTO_LOGIN_ENABLED=false
AUTO_LOGIN_USER_ID=
AUTO_LOGIN_INSTITUTION_ID=

# Cloudflare/Dokploy API credentials do NOT belong in this application environment.
