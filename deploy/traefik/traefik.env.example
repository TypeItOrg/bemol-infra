# Private /etc/bemol/traefik/traefik.env, not the application environment.
# Directory 0700; token and ACME JSON 0600; never add secrets as YAML there.
# Scope: bemol.com.ar with Zone:Read + DNS:Edit; no paid Cloudflare feature.
CF_DNS_API_TOKEN_FILE=/etc/traefik/dynamic/.secrets/cloudflare-dns-token
