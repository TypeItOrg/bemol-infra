# Dokploy > Traefik environment, NOT the Boero application environment.
# Admin provisions this private file in the already-mounted dynamic directory.
# Directory 0700; token and ACME JSON 0600; never add secrets as YAML there.
# Scope token to typeit.com.ar with Zone:Read + DNS:Edit. No paid CF feature.
CF_DNS_API_TOKEN_FILE=/etc/dokploy/traefik/dynamic/.secrets/cloudflare-dns-token
